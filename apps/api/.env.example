# Motion ERP API environment. Copy to `.env` for local development.
# Never commit the real `.env`.

NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api

# Comma-separated list of allowed browser origins (the web app dev server).
API_CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection. In this phase it is only used by the /health/db check.
# No business tables are created.
DATABASE_URL=postgresql://motion:change_me_for_local_dev@localhost:5432/motion_erp
