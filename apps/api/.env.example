# Motion ERP API environment. Copy to `.env` for local development.
# Never commit the real `.env`.

NODE_ENV=development
API_PORT=3000
API_GLOBAL_PREFIX=api

# Comma-separated list of allowed browser origins (the web app dev server).
API_CORS_ORIGINS=http://localhost:5173

# PostgreSQL connection. In this phase it is only used by the /health/db check.
# No business tables are created.
DATABASE_URL=postgresql://motion:change_me_for_local_dev@localhost:5432/motion_erp

# Authentication. The secret signs login tokens (at least 32 characters; required in production).
# Without it in development, a random secret is generated at startup (tokens die on restart).
# AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_SECONDS=28800
# "true" (the default) rejects every request without a valid login token.
AUTH_ENFORCE=true
# First administrator, created at startup if that username does not exist (password: 8+ characters).
# Set it for the first start on a fresh database, then log in and change it.
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_PASSWORD=
